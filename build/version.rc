#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "ScreenPen"
            VALUE "FileDescription",  "ScreenPen - 屏幕画笔 / 实时缩放 / 截图"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "ScreenPen"
            VALUE "LegalCopyright",   "ScreenPen"
            VALUE "OriginalFilename", "ScreenPen.exe"
            VALUE "ProductName",      "ScreenPen"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
