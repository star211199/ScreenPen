# ---- build outputs ---------------------------------------------------------
# Probe executables, their transcripts and intermediate objects. Regenerated by
# build\build.ps1 and build\run_probes.ps1; never source.
build/obj/

# Captured UI screenshots used by the pixel-diff verifiers. They are regenerated
# by build\capture_ui.py / render_ui.cs and are pure test fixtures.
build/shots/

# Ad-hoc screenshots produced by the e2e run.
build/testshots/

# ---- crash / error logs ----------------------------------------------------
*.error.log
error.log
crash.log

# ---- the shipped binary is intentionally tracked ---------------------------
# dist/ScreenPen.exe is committed on purpose so a user can download and run the
# tool without a compiler. Do not add it here.
!dist/ScreenPen.exe

# ---- OS / editor noise -----------------------------------------------------
Thumbs.db
Desktop.ini
*~
*.swp

# ---- local machine state ---------------------------------------------------
# The live settings file is written next to the EXE at runtime, so a developer's
# personal hotkeys and palette would otherwise show up as a diff on every run.
dist/ScreenPen.settings.json
